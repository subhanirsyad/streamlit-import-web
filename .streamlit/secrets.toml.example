# Isi di Streamlit Cloud: App -> Settings -> Secrets (tempel teks ini setelah diisi). JANGAN di-commit.

# Email di luar @warnaemasindonesia.com yang juga boleh masuk (harus di atas semua [bagian]).
allowed_emails = ["nama@gmail.com"]

[auth]
redirect_uri = "https://NAMA-APP.streamlit.app/oauth2callback"   # harus ada di "Authorized redirect URIs" client Google
cookie_secret = "isi-string-acak-panjang"
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "isi-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Isi credentials.json (service account yang punya akses edit ke sheet Cussons, NPURE, Blood).
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "..."
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
